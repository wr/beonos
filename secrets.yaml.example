# Copy this and fill in your values. Do NOT commit this to git.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Generate with `openssl rand -base64 32` and paste below
api_encryption_key: ""

# Pick anything; you'll use it for OTA updates
ota_password: "change-me"

# Used only when WiFi fails; the device exposes a fallback AP
fallback_password: "change-me-too"
